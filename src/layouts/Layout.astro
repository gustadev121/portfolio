---
import '@/styles/global.css';
import '@fontsource-variable/figtree';
import '@fontsource-variable/fredoka';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
}

const { currentLocale } = Astro;
const { title, description } = Astro.props;
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="flex flex-col items-center text-secondary-foreground">
    <div
      class="fixed inset-0 min-h-screen w-full -z-10 top-0 bg-white dark:bg-[#01081f] bg-linear-to-b from-primary/10 via-transparent to-secondary/15 transition-colors duration-500 overflow-hidden pointer-events-none"
    >
      <div
        class="absolute -top-40 left-1/2 -translate-x-1/2 w-[650px] h-[350px] bg-primary/20 dark:bg-primary/30 blur-[130px] rounded-full"
      >
      </div>
      <div
        class="absolute top-1/3 -left-40 w-[500px] h-[400px] bg-accent/15 dark:bg-secondary/25 blur-[140px] rounded-full"
      >
      </div>
      <div
        class="absolute -bottom-20 -right-20 w-[450px] h-[350px] bg-tertiary/15 dark:bg-accent/15 blur-[120px] rounded-full"
      >
      </div>
    </div>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    color-scheme: light dark;
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
