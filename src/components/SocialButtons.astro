---
import { IconBrandGithub, IconBrandLinkedin, IconMail } from '@tabler/icons-astro';
import Button from '@/components/ui/Button.astro';

const socialMedia = [
  {
    social: 'github',
    link: 'https://github.com/gustadev121',
    icon: IconBrandGithub,
    class: 'stroke-button-foreground group-hover:stroke-accent',
  },
  {
    social: 'linkedin',
    link: 'https://linkedin.com/in/luisgustavoseq/',
    icon: IconBrandLinkedin,
    class: 'stroke-button-foreground group-hover:stroke-accent',
  },
  {
    social: 'email',
    link: 'mailto:lgsc21211@gmail.com',
    icon: IconMail,
    class: 'stroke-button-foreground group-hover:stroke-accent',
  },
];
---

<menu class="flex gap-4 justify-center">
  {
    socialMedia.map(({ link, social, icon: Icon, class: className }) => (
      <li>
        <Button as="a" href={link} aria-label={social}>
          <Icon slot="icon" size={20} class={className} />
        </Button>
      </li>
    ))
  }
</menu>
