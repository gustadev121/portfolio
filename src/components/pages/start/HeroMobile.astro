---
import { Image } from 'astro:assets';
import { IconBrandReact, IconBrandTailwind } from '@tabler/icons-astro';
import heroImage from '@/assets/images/gustadev.webp';
import SocialButtons from '@/components/SocialButtons.astro';
import Section from '@/components/ui/Section.astro';
import { getI18n, type Locale } from '@/i18n/index';

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale: currentLocale as Locale });
---

<Section class="flex-col justify-between gap-8 items-center md:hidden">
  <div class="flex flex-col gap-2 items-center text-center">
    <h1
      class="text-4xl sm:text-5xl font-primary font-medium tracking-tight text-primary-foreground dark:text-white"
    >
      Gustavo Sequeiros
    </h1>
    <h2 class="text-2xl sm:text-3xl font-primary font-medium text-sky-600 dark:text-sky-400">
      {i18n.HERO.SUBTITLE}
    </h2>
  </div>
  <div class="flex flex-col gap-5 items-center">
    <div class="relative group">
      <!-- Ambient Glow Behind Avatar -->
      <div
        class="absolute -inset-3 bg-gradient-to-tr from-sky-400/20 via-indigo-500/20 to-sky-300/15 rounded-full blur-xl -z-10 pointer-events-none"
      >
      </div>
      <!-- Floating Tech Badge 1: React -->
      <div
        class="absolute -top-2 -right-2 z-10 flex items-center gap-1 px-2.5 py-1 rounded-xl bg-white/95 dark:bg-slate-800/95 border border-sky-100/80 dark:border-white/15 shadow-md shadow-sky-500/10 backdrop-blur-md select-none"
      >
        <IconBrandReact class="size-3.5 text-cyan-500" />
        <span class="text-[11px] font-semibold text-primary-foreground dark:text-slate-100">React</span>
      </div>
      <!-- Floating Tech Badge 2: Tailwind -->
      <div
        class="absolute -bottom-2 -left-2 z-10 flex items-center gap-1 px-2.5 py-1 rounded-xl bg-white/95 dark:bg-slate-800/95 border border-sky-100/80 dark:border-white/15 shadow-md shadow-blue-500/10 backdrop-blur-md select-none"
      >
        <IconBrandTailwind class="size-3.5 text-sky-500" />
        <span class="text-[11px] font-semibold text-primary-foreground dark:text-slate-100">Tailwind</span>
      </div>
      <!-- Avatar Image -->
      <div
        class="p-1 rounded-full bg-sky-50/70 dark:bg-slate-800/80 ring-1 ring-sky-100/80 dark:ring-white/10 shadow-lg shadow-sky-900/5"
      >
        <Image
          src={heroImage}
          alt="Gustavo Sequeiros"
          class="rounded-full aspect-square max-w-56 sm:max-w-64 bg-white dark:bg-slate-900"
        />
      </div>
    </div>
    <SocialButtons />
  </div>
  <article
    class="relative overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-linear-to-r before:from-transparent before:via-sky-200/70 dark:before:via-white/15 before:to-transparent bg-white/85 dark:bg-secondary/25 text-secondary-foreground p-5 text-lg text-pretty shadow-[0_8px_30px_-12px_rgba(2,132,199,0.18)] dark:shadow-container rounded-2xl max-w-md border border-sky-100/70 dark:border-white/10 leading-relaxed backdrop-blur-md flex flex-col gap-4"
  >
    <div set:html={i18n.HERO.DESCRIPTION} />
    <div class="grid grid-cols-3 gap-2 pt-3 border-t border-sky-100/70 dark:border-white/5">
      <div class="flex flex-col p-2 rounded-lg bg-sky-50/80 dark:bg-slate-800/40 border border-sky-100/80 dark:border-white/5 text-center">
        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Enfoque</span>
        <span class="text-xs font-semibold text-sky-600 dark:text-sky-400">Frontend</span>
      </div>
      <div class="flex flex-col p-2 rounded-lg bg-sky-50/80 dark:bg-slate-800/40 border border-sky-100/80 dark:border-white/5 text-center">
        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Stack</span>
        <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">React/Astro</span>
      </div>
      <div class="flex flex-col p-2 rounded-lg bg-sky-50/80 dark:bg-slate-800/40 border border-sky-100/80 dark:border-white/5 text-center">
        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Ubicación</span>
        <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">Perú 🇵🇪</span>
      </div>
    </div>
  </article>
</Section>
