---
import { Image } from 'astro:assets';
import heroImage from '@/assets/images/gustadev.webp';
import SocialButtons from '@/components/SocialButtons.astro';
import Section from '@/components/ui/Section.astro';
import { getI18n, type Locale } from '@/i18n/index';

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale: currentLocale as Locale });
---

<Section class="flex-col justify-between gap-10 items-center md:hidden">
  <div class="flex flex-col gap-3 items-center">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20 w-fit backdrop-blur-xs shadow-xs"
    >
      <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>{i18n.HERO.SUBTITLE}</span>
    </div>
    <h1
      class="text-5xl sm:text-6xl font-primary font-medium text-center tracking-tight text-slate-900 dark:text-white"
    >
      Gustavo Sequeiros
    </h1>
  </div>
  <div class="flex flex-col gap-5 items-center">
    <div class="relative group">
      <div
        class="p-1 rounded-full bg-slate-100 dark:bg-slate-800/80 ring-1 ring-slate-200 dark:ring-white/10 shadow-lg shadow-slate-900/5"
      >
        <Image
          src={heroImage}
          alt="Gustavo Sequeiros"
          class="rounded-full aspect-square max-w-64 sm:max-w-72 bg-white dark:bg-slate-900"
        />
      </div>
    </div>
    <SocialButtons />
  </div>
  <article
    class="relative overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-linear-to-r before:from-transparent before:via-white/40 dark:before:via-white/15 before:to-transparent bg-white/80 dark:bg-secondary/25 text-secondary-foreground p-4 text-lg sm:text-xl text-pretty shadow-sm dark:shadow-container rounded-2xl max-w-md border border-slate-200/80 dark:border-white/10 leading-relaxed backdrop-blur-md"
    set:html={i18n.HERO.DESCRIPTION}
  />
</Section>
