---
import { Image } from 'astro:assets';
import heroImage from '@/assets/images/gustadev.webp';
import SocialButtons from '@/components/SocialButtons.astro';
import Section from '@/components/ui/Section.astro';
import { getI18n, type Locale } from '@/i18n/index';

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale: currentLocale as Locale });
---

<Section class="flex-col justify-between gap-10 items-center md:hidden">
  <div class="flex flex-col gap-3 items-center">
    <h1
      class="text-primary-foreground text-5xl sm:text-6xl font-primary font-medium text-center tracking-tight"
    >
      Gustavo Sequeiros
    </h1>
    <h3 class="text-tertiary text-3xl sm:text-4xl font-primary text-center">
      {i18n.HERO.SUBTITLE}
    </h3>
  </div>
  <div class="flex flex-col gap-5 items-center">
    <Image
      src={heroImage}
      alt="Gustavo Sequeiros"
      class="rounded-full aspect-square max-w-64 sm:max-w-72 shadow-container border-2 border-primary/20"
    />
    <SocialButtons />
  </div>
  <article
    class="relative overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-linear-to-r before:from-transparent before:via-white/35 dark:before:via-white/20 before:to-transparent bg-secondary/15 dark:bg-secondary/10 text-secondary-foreground p-4 text-lg sm:text-xl text-pretty shadow-container shadow-secondary/40 rounded-2xl max-w-md border border-secondary/20 leading-relaxed backdrop-blur-xs"
    set:html={i18n.HERO.DESCRIPTION}
  />
</Section>
