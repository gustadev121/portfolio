---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class={cn(
    'inline-flex gap-1.5 py-1 px-2.5 text-xs font-semibold rounded-full items-center shadow-xs border transition-all duration-200 hover:scale-105 select-none bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/25',
    className,
  )}
>
  <slot name="icon" />
  <span class="whitespace-nowrap"><slot /></span>
</div>
