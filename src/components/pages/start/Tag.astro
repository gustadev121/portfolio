---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class={cn(
    'inline-flex gap-1.5 py-1 px-2.5 bg-secondary/90 dark:bg-secondary/80 text-white text-xs font-medium rounded-full items-center shadow-xs border border-white/10 select-none',
    className,
  )}
>
  <slot name="icon" />
  <span class="whitespace-nowrap"><slot /></span>
</div>
