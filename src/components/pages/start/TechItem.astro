---
import { cn } from '@/lib/utils';

interface Props {
  info: string;
  class?: string;
}

const { info, class: className } = Astro.props;
---

<div
  class={cn(
    'p-4 md:p-5 size-16 md:size-20 rounded-2xl relative transition-all duration-200 group flex items-center justify-center border border-sky-100/80 dark:border-white/10 shadow-[0_8px_20px_-10px_rgba(2,132,199,0.25)] dark:shadow-md hover:shadow-[0_12px_28px_-10px_rgba(2,132,199,0.35)] hover:-translate-y-1 active:scale-95 cursor-pointer',
    className,
  )}
>
  <div
    class="absolute -top-10 left-1/2 -translate-x-1/2 text-center text-xs font-medium text-white py-1 px-2.5 rounded-lg bg-slate-900/95 dark:bg-slate-800/95 backdrop-blur-md border border-slate-900/20 dark:border-white/15 shadow-lg opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 group-focus:opacity-100 transition-all duration-200 pointer-events-none whitespace-nowrap z-20"
  >
    {info}
  </div>
  <slot />
</div>
