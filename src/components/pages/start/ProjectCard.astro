---
import { Image } from 'astro:assets';
import { IconBrandGithub, IconLink } from '@tabler/icons-astro';
import Button from '@/components/ui/Button.astro';
import { getI18n, type Locale } from '@/i18n/index';
import type { ProjectCardType } from '@/types';
import Tag from './Tag.astro';

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale: currentLocale as Locale });

type Props = ProjectCardType;

const { img, title, tags, description, github, preview } = Astro.props;
---

<article
  class="group relative flex flex-col p-6 justify-between gap-8 bg-white/85 dark:bg-secondary/25 border border-sky-100/70 dark:border-white/10 rounded-2xl shadow-[0_8px_30px_-12px_rgba(2,132,199,0.18)] dark:shadow-container hover:shadow-[0_16px_40px_-16px_rgba(2,132,199,0.3)] dark:hover:shadow-secondary/30 transition-all duration-300 backdrop-blur-md overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-linear-to-r before:from-transparent before:via-sky-200/70 dark:before:via-white/15 before:to-transparent"
>
  <div class="flex flex-col gap-6">
    <div class="relative overflow-hidden rounded-xl border border-sky-100/70 dark:border-white/10 bg-sky-50/60 dark:bg-slate-900/50 aspect-video flex items-center justify-center">
      <Image
        src={img}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 project-card-image"
      />
    </div>
    <div class="flex flex-col gap-3">
      <h3 class="text-2xl lg:text-3xl text-primary-foreground font-primary font-medium tracking-tight group-hover:text-accent transition-colors duration-200">
        {title}
      </h3>
      <div class="flex flex-wrap gap-1.5">
        {
          tags.map(({ icon: Icon, content, class: className, iconClass }) => (
            <Tag class={className}>
              {Icon && <Icon slot="icon" class:list={['w-3.5 h-3.5', iconClass]} />}
              {content}
            </Tag>
          ))
        }
      </div>
    </div>
    <div class="text-secondary-foreground leading-relaxed text-pretty text-base">
      {description}
    </div>
  </div>
  <div class="flex gap-3 justify-end pt-2 border-t border-sky-100/70 dark:border-white/5">
    {
      preview && (
        <Button as="a" href={preview} class="py-2 px-4 text-sm font-medium">
          <IconLink
            slot="icon"
            class="w-4 h-4 stroke-button-foreground group-hover:stroke-accent"
          />
          {i18n.PROJECTS.CARD.PREVIEW}
        </Button>
      )
    }
    <Button as="a" href={github} class="py-2 px-4 text-sm font-medium">
      <IconBrandGithub
        slot="icon"
        class="w-4 h-4 stroke-button-foreground group-hover:stroke-accent"
      />
      {i18n.PROJECTS.CARD.SOURCE_CODE}
    </Button>
  </div>
</article>

<script>
  document.addEventListener('astro:page-load', () => {
    // Interactive tilt effect
    const images = document.getElementsByClassName(
      'project-card-image',
    ) as HTMLCollectionOf<HTMLImageElement>;

    if (images) {
      Array.from(images).forEach((img) => {
        img.addEventListener('mousemove', (e) => {
          const rect = img.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;

          // Calcular la posición del mouse relativa al centro
          const mouseX = e.clientX - centerX;
          const mouseY = e.clientY - centerY;

          // Convertir a porcentajes y limitar el rango
          const rotateX = (mouseY / rect.height) * -15;
          const rotateY = (mouseX / rect.width) * 15;
          img.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        img.addEventListener('mouseleave', () => {
          img.style.transform =
            'perspective(1200px) rotateX(0deg) rotateY(0deg)';
        });
      });
    }
  });
</script>
