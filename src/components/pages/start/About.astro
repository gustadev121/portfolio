---
import { Image } from 'astro:assets';
import { IconUser } from '@tabler/icons-astro';
import AboutImage from '@/assets/images/about.webp';
import Section from '@/components/ui/Section.astro';
import Title from '@/components/ui/Title.astro';
import { RootSections } from '@/config/pages';
import { DEFAULT_LOCALE, getI18n, type Locale } from '@/i18n/index';

const currentLocale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const i18n = getI18n({ currentLocale: currentLocale });
---

<Section class="flex-col" id={RootSections[currentLocale].ABOUT_ME}>
  <Title>
    <IconUser class="size-8 md:size-9 stroke-sky-600 dark:stroke-sky-400" />
    {i18n.ABOUT.TITLE}
  </Title>
  <div
    class="relative overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-linear-to-r before:from-transparent before:via-sky-200/70 dark:before:via-white/15 before:to-transparent flex flex-col md:flex-row gap-8 lg:gap-12 items-center bg-white/85 dark:bg-secondary/25 p-6 md:p-10 rounded-2xl border border-sky-100/70 dark:border-white/10 shadow-[0_8px_30px_-12px_rgba(2,132,199,0.18)] dark:shadow-container backdrop-blur-md"
  >
    <div class="flex-1 text-secondary-foreground">
      <p
        class="text-lg md:text-xl leading-relaxed text-pretty"
        set:html={i18n.ABOUT.DESCRIPTION}
      />
    </div>
    <div class="w-full max-w-xs md:max-w-sm shrink-0">
      <Image
        src={AboutImage}
        alt="Gustavo Sequeiros profile"
        class="w-full rounded-2xl shadow-lg border border-secondary/20 object-cover aspect-[4/5]"
      />
    </div>
  </div>
</Section>
