---
import AstroLogo from '@/assets/icons/astro.svg';
import MotionLogo from '@/assets/icons/motion.svg';
import NextJSLogo from '@/assets/icons/nextjs.svg';
import ReactLogo from '@/assets/icons/react.svg';
import StackIcon from '@/assets/icons/stack.svg';
import SupabaseLogo from '@/assets/icons/supabase.svg';
import TailwindLogo from '@/assets/icons/tailwindcss.svg';
import UnityLogo from '@/assets/icons/unity.svg';
import VercelLogo from '@/assets/icons/vercel.svg';
import Section from '@/components/ui/Section.astro';
import Title from '@/components/ui/Title.astro';
import { RootSections } from '@/config/pages';
import { DEFAULT_LOCALE, getI18n, type Locale } from '@/i18n/index';
import type { TechType } from '@/types';
import TechItem from './TechItem.astro';

const { currentLocale = DEFAULT_LOCALE } = Astro;
const i18n = getI18n({ currentLocale: currentLocale as Locale });

const techs: TechType[] = [
  {
    content: 'Tailwind CSS',
    class: 'bg-[#003159]',
    icon: TailwindLogo,
  },
  {
    content: 'Next JS',
    class: 'bg-black',
    icon: NextJSLogo,
  },
  {
    content: 'React',
    class: 'bg-[#23272F]',
    icon: ReactLogo,
  },
  {
    content: 'Motion',
    class: 'bg-[#1A202C]',
    icon: MotionLogo,
  },
  {
    content: 'Unity',
    class: 'bg-black',
    icon: UnityLogo,
  },
  {
    content: 'Supabase',
    class: 'bg-[#1A202C]',
    icon: SupabaseLogo,
  },
  {
    content: 'Vercel',
    class: 'bg-black',
    icon: VercelLogo,
  },
  {
    content: 'Astro',
    class: 'bg-black',
    icon: AstroLogo,
  },
];
---

<Section class="flex-col" id={RootSections[currentLocale as Locale].STACK_TECH}>
  <Title>
    <StackIcon class="size-10 stroke-primary-foreground" />
    {i18n.STACK_TECH.TITLE}
  </Title>
  <div class="flex flex-wrap gap-x-8 gap-y-16 justify-center">
    {
      techs.map(({ content, class: className, icon: Icon, iconClass }) => (
        <TechItem info={content} class={className}>
          <Icon class:list={['size-full', iconClass]} />
        </TechItem>
      ))
    }
  </div>
</Section>
