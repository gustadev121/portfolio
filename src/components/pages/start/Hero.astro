---
import { Image } from 'astro:assets';
import { IconBrandReact, IconBrandTailwind } from '@tabler/icons-astro';
import heroImage from '@/assets/images/gustadev.webp';
import SocialButtons from '@/components/SocialButtons.astro';
import Section from '@/components/ui/Section.astro';
import { getI18n, type Locale } from '@/i18n/index';

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale: currentLocale as Locale });
const heroId = 'hero-section';
---

<Section
  id={heroId}
  class="justify-between gap-[10%] items-center hidden md:flex"
>
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <h1 class="text-5xl lg:text-6xl font-primary font-medium tracking-tight text-primary-foreground dark:text-white">
        Gustavo Sequeiros
      </h1>
      <h2 class="text-3xl lg:text-4xl font-primary font-medium text-sky-600 dark:text-sky-400">
        {i18n.HERO.SUBTITLE}
      </h2>
    </div>

    <article
      class="relative overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-linear-to-r before:from-transparent before:via-sky-200/70 dark:before:via-white/15 before:to-transparent bg-white/85 dark:bg-secondary/25 text-secondary-foreground p-6 text-xl text-pretty shadow-[0_8px_30px_-12px_rgba(2,132,199,0.18)] dark:shadow-container rounded-2xl max-w-xl border border-sky-100/70 dark:border-white/10 leading-relaxed backdrop-blur-md flex flex-col gap-5"
    >
      <div set:html={i18n.HERO.DESCRIPTION} />
      <div class="grid grid-cols-3 gap-2.5 pt-3 border-t border-sky-100/70 dark:border-white/5">
        <div class="flex flex-col p-2.5 rounded-xl bg-sky-50/80 dark:bg-slate-800/40 border border-sky-100/80 dark:border-white/5">
          <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Enfoque</span>
          <span class="text-sm font-semibold text-sky-600 dark:text-sky-400">Frontend / UI</span>
        </div>
        <div class="flex flex-col p-2.5 rounded-xl bg-sky-50/80 dark:bg-slate-800/40 border border-sky-100/80 dark:border-white/5">
          <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Stack</span>
          <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400">React & Astro</span>
        </div>
        <div class="flex flex-col p-2.5 rounded-xl bg-sky-50/80 dark:bg-slate-800/40 border border-sky-100/80 dark:border-white/5">
          <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Ubicación</span>
          <span class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">Perú 🇵🇪</span>
        </div>
      </div>
    </article>

  </div>
  <div class="flex flex-col gap-6 items-center">
    <div class="relative group">
      <!-- Ambient Glow Behind Avatar -->
      <div
        class="absolute -inset-4 bg-gradient-to-tr from-sky-400/20 via-indigo-500/20 to-sky-300/15 rounded-full blur-2xl -z-10 pointer-events-none"
      >
      </div>
      <!-- Floating Tech Badge 1: React -->
      <div
        class="absolute -top-3 -right-3 z-10 flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/95 dark:bg-slate-800/95 border border-sky-100/80 dark:border-white/15 shadow-md shadow-sky-500/10 backdrop-blur-md transition-transform duration-300 group-hover:scale-105 select-none"
      >
        <IconBrandReact class="size-4 text-cyan-500" />
        <span class="text-xs font-semibold text-primary-foreground dark:text-slate-100">React</span>
      </div>
      <!-- Floating Tech Badge 2: Tailwind -->
      <div
        class="absolute -bottom-3 -left-3 z-10 flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/95 dark:bg-slate-800/95 border border-sky-100/80 dark:border-white/15 shadow-md shadow-blue-500/10 backdrop-blur-md transition-transform duration-300 group-hover:scale-105 select-none"
      >
        <IconBrandTailwind class="size-4 text-sky-500" />
        <span class="text-xs font-semibold text-primary-foreground dark:text-slate-100">Tailwind</span>
      </div>
      <!-- Avatar Image -->
      <div
        class="p-1 rounded-full bg-sky-50/70 dark:bg-slate-800/80 ring-1 ring-sky-100/80 dark:ring-white/10 shadow-lg shadow-sky-900/5 transition-transform duration-300 group-hover:scale-[1.02]"
      >
        <Image
          src={heroImage}
          alt="Gustavo Sequeiros"
          class="rounded-full aspect-square max-w-72 transform-3d transition-transform duration-100 ease-out bg-white dark:bg-slate-900"
          id="hero-image"
        />
      </div>
    </div>
    <SocialButtons />
  </div>
</Section>

<script>
  document.addEventListener('astro:page-load', () => {
    const heroId = 'hero-section';
    let heroContainer = document.getElementById(heroId);

    const callback: IntersectionObserverCallback = ([entry]) => {
      const isSticky = !entry.isIntersecting;
      document.dispatchEvent(
        new CustomEvent('is-navbar-sticky', { detail: isSticky }),
      );
    };

    const observer = new IntersectionObserver(callback, { threshold: 0.01 });

    heroContainer = document.getElementById(heroId);

    if (heroContainer) observer.observe(heroContainer);

    // Interactive tilt effect
    const heroImage = document.getElementById('hero-image');

    if (heroImage) {
      heroImage.addEventListener('mousemove', (e) => {
        const rect = heroImage.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        // Calcular la posición del mouse relativa al centro
        const mouseX = e.clientX - centerX;
        const mouseY = e.clientY - centerY;

        // Convertir a porcentajes y limitar el rango
        const rotateX = (mouseY / rect.height) * -30;
        const rotateY = (mouseX / rect.width) * 30;

        heroImage.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.05, 1.05, 1.05)`;
      });

      heroImage.addEventListener('mouseleave', () => {
        heroImage.style.transform =
          'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    }
  });
</script>
