---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { cn } from '@/lib/utils';

type TagType = 'a' | 'button';

type Props<TagName extends HTMLTag> = Polymorphic<{ as: TagName & TagType }>;

const { as: Tag, class: className, ...rest } = Astro.props;
---

<Tag
  class={cn(
    'flex justify-center items-center gap-1.5 px-3 py-3 rounded-full border border-sky-100/80 dark:border-white/10 text-button-foreground bg-button hover:bg-button-hover hover:border-accent hover:text-accent hover:shadow-[0_6px_20px_-8px_rgba(10,111,227,0.35)] active:scale-[0.97] transition-all duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent shadow-sm group',
    className,
  )}
  {...rest}
>
  <slot name="icon" />
  <slot />
</Tag>
