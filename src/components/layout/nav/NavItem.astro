---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { cn } from '@/lib/utils';

type TagType = 'a' | 'button';

type Props<TagName extends HTMLTag> = Polymorphic<{ as: TagName & TagType }>;

const { as: Tag, class: className, ...rest } = Astro.props;
---

<Tag
  class={cn(
    'flex gap-2 text-navbar-foreground stroke-navbar-foreground items-center px-2.5 py-1.5 rounded-xl hover:text-accent hover:stroke-accent hover:bg-accent/15 active:scale-[0.95] transition-all duration-150 ease-out hover:cursor-pointer group select-none',
    className,
  )}
  {...rest}
>
  <slot />
</Tag>
