---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';

type Props = HTMLAttributes<'ul'>;

const { class: className, ...rest } = Astro.props;
---

<ul
  class={cn(
    'absolute w-max right-10 md:bottom-12 md:left-0 flex flex-col gap-1 text-navbar-foreground p-1.5 bg-navbar border border-slate-200/90 dark:border-white/10 rounded-xl shadow-xl shadow-black/20 backdrop-blur-xl hidden animate-in h-max z-40',
    className,
  )}
  {...rest}
>
  <slot />
</ul>
